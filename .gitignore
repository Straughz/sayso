# Build output
/target/
/src-tauri/target/
/src-tauri/gen/
/ui/node_modules/
/ui/dist/
/installer/out/

# Audio captures and logs are created at runtime under %LOCALAPPDATA%, never
# here; if one lands in the tree by mistake it must not be committed.
*.wav
captures/
logs/

# Secrets: the API key is stored DPAPI-encrypted by the app, never in a file
# in this tree.
.env
.env.*
*.enc
*.pem
*.key
